<div class="w-full max-w-sm">
  <div class="text-center mb-8 animate-fade-in-up">
    <div class="mb-4 animate-float">
      <%= image_tag "logo.svg", alt: "FactHub", class: "w-16 h-16 inline-block", style: "filter: drop-shadow(0 0 20px rgba(99, 102, 241, 0.5)) drop-shadow(0 0 40px rgba(139, 92, 246, 0.3));" %>
    </div>
    <h1 class="text-3xl font-bold text-white tracking-tight">Fact Hub</h1>
    <p class="text-indigo-300 text-sm mt-1">Admin area</p>
  </div>

  <div class="bg-white/95 backdrop-blur-sm rounded-2xl shadow-2xl p-8 animate-fade-in-up-delay-1">
    <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
      <div class="mb-4">
        <%= f.label :email, class: "block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1.5" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email",
                          class: "w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-2.5 text-sm text-slate-900 placeholder-slate-400 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200 focus:bg-white focus:outline-none transition-all duration-200" %>
      </div>

      <div class="mb-6">
        <%= f.label :password, class: "block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1.5" %>
        <%= f.password_field :password, autocomplete: "current-password",
                             class: "w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-2.5 text-sm text-slate-900 placeholder-slate-400 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200 focus:bg-white focus:outline-none transition-all duration-200" %>
      </div>

      <%= f.submit "Sign in", class: "w-full rounded-xl bg-gradient-to-r from-indigo-600 to-purple-600 px-4 py-2.5 text-sm font-semibold text-white hover:from-indigo-700 hover:to-purple-700 active:from-indigo-800 active:to-purple-800 cursor-pointer transition-all duration-200 shadow-lg shadow-indigo-500/25 hover:shadow-indigo-500/40 animate-gradient" %>
    <% end %>
  </div>

  <p class="text-center mt-6 text-indigo-400/50 text-xs animate-fade-in-up-delay-2">Secure admin access</p>
</div>
