<div class="fixed top-4 right-4 z-50 flex flex-col gap-2 pointer-events-none">
  <% if notice.present? %>
    <div data-controller="toast"
         class="pointer-events-auto flex items-center gap-3 rounded-xl bg-emerald-500 text-white px-4 py-3 text-sm font-medium shadow-lg transition-all duration-300 ease-out min-w-64 max-w-sm">
      <span class="text-base shrink-0">&#x2713;</span>
      <span><%= notice %></span>
      <button data-action="toast#dismiss" class="ml-auto shrink-0 text-white/70 hover:text-white transition">&times;</button>
    </div>
  <% end %>

  <% if alert.present? %>
    <div data-controller="toast"
         class="pointer-events-auto flex items-center gap-3 rounded-xl bg-red-500 text-white px-4 py-3 text-sm font-medium shadow-lg transition-all duration-300 ease-out min-w-64 max-w-sm">
      <span class="text-base shrink-0">&#x26A0;</span>
      <span><%= alert %></span>
      <button data-action="toast#dismiss" class="ml-auto shrink-0 text-white/70 hover:text-white transition">&times;</button>
    </div>
  <% end %>
</div>

