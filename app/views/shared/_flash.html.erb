<div class="fixed top-4 right-4 z-50 flex flex-col items-end gap-2 pointer-events-none" style="left: 1rem; right: 1rem; max-width: 100vw;">
  <% if notice.present? %>
    <div data-controller="toast"
         class="pointer-events-auto flex items-center gap-3 rounded-xl bg-emerald-500 text-white px-4 py-3 text-sm font-medium shadow-lg transition-all duration-300 ease-out" style="max-width: 100%; width: auto;">
      <span class="text-base shrink-0">&#x2713;</span>
      <span class="break-words min-w-0"><%= notice %></span>
      <button data-action="toast#dismiss" class="ml-auto shrink-0 text-white/70 hover:text-white transition">&times;</button>
    </div>
  <% end %>

  <% if alert.present? %>
    <div data-controller="toast"
         class="pointer-events-auto flex items-center gap-3 rounded-xl bg-red-500 text-white px-4 py-3 text-sm font-medium shadow-lg transition-all duration-300 ease-out" style="max-width: 100%; width: auto;">
      <span class="text-base shrink-0">&#x26A0;</span>
      <span class="break-words min-w-0"><%= alert %></span>
      <button data-action="toast#dismiss" class="ml-auto shrink-0 text-white/70 hover:text-white transition">&times;</button>
    </div>
  <% end %>
</div>

