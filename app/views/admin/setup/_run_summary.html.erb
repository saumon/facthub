<%# Shared partial for import run terminal summary %>
<div class="space-y-3">
  <div class="flex flex-wrap gap-4 text-sm">
    <span class="inline-flex items-center gap-1 font-medium
                 <%= run.status == 'completed' ? 'text-emerald-600' :
                     run.status == 'completed_with_errors' ? 'text-amber-600' :
                     'text-red-600' %>">
      <%= run.status.humanize %>
    </span>
    <span class="text-slate-400">
      <%= (run.completed_at || run.created_at).strftime("%b %d, %Y · %H:%M") %>
    </span>
    <span class="text-slate-600">
      <strong><%= run.added_facts_count %></strong> facts added
    </span>
    <span class="text-slate-600">
      <strong><%= run.ignored_duplicates_count %></strong> duplicates ignored
    </span>
    <% if run.invalid_files_count.positive? %>
      <span class="text-amber-600">
        <strong><%= run.invalid_files_count %></strong>
        <%= 'file'.pluralize(run.invalid_files_count) %> rejected
      </span>
    <% end %>
  </div>

  <% if run.fact_import_files.any? %>
    <div class="overflow-hidden rounded-xl border border-slate-200">
      <table class="w-full text-sm">
        <thead>
          <tr class="bg-slate-50 border-b border-slate-200">
            <th class="px-4 py-2 text-left font-semibold text-slate-500 text-xs uppercase tracking-wider">File</th>
            <th class="px-4 py-2 text-left font-semibold text-slate-500 text-xs uppercase tracking-wider">Status</th>
            <th class="px-4 py-2 text-right font-semibold text-slate-500 text-xs uppercase tracking-wider">Added</th>
            <th class="px-4 py-2 text-right font-semibold text-slate-500 text-xs uppercase tracking-wider">Ignored</th>
            <th class="px-4 py-2 text-left font-semibold text-slate-500 text-xs uppercase tracking-wider">Note</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% run.fact_import_files.each do |file| %>
            <tr class="<%= file.rejected? ? 'bg-red-50/50' : 'hover:bg-indigo-50/30' %> transition">
              <td class="px-4 py-2 font-mono text-slate-700 text-xs"><%= file.filename %></td>
              <td class="px-4 py-2">
                <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium
                             <%= file.status == 'completed' ? 'bg-emerald-100 text-emerald-700' :
                                 file.status.start_with?('rejected') ? 'bg-red-100 text-red-700' :
                                 'bg-slate-100 text-slate-600' %>">
                  <%= file.status.humanize %>
                </span>
              </td>
              <td class="px-4 py-2 text-right text-slate-700"><%= file.added_facts_count %></td>
              <td class="px-4 py-2 text-right text-slate-700"><%= file.ignored_duplicates_count %></td>
              <td class="px-4 py-2 text-xs text-slate-400 truncate max-w-xs">
                <%= file.error_message.presence || "—" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>
