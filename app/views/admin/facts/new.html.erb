<div class="mb-6">
  <%= link_to admin_facts_path, class: "inline-flex items-center gap-1 text-sm text-indigo-300 hover:text-white transition" do %>
    &#8592; Back to Facts
  <% end %>
</div>

<h1 class="text-2xl font-bold text-white mb-6">New Fact</h1>

<div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-8">
  <%= form_with model: [:admin, @fact] do |form| %>
    <%= render "form", fact: @fact, form: form %>
  <% end %>
</div>
