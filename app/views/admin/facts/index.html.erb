<div class="flex items-center justify-between mb-8">
  <div>
    <h1 class="text-2xl font-bold text-white">Fun Facts</h1>
    <p class="text-sm text-indigo-300 mt-0.5"><%= pluralize(@total_facts, "fact") %> in the database</p>
  </div>
  <%= link_to new_admin_fact_path(page: @current_page),
              class: "inline-flex items-center gap-1.5 rounded-xl bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-700 active:bg-indigo-800 transition shadow-sm" do %>
    <span class="text-base leading-none">&#43;</span> New Fact
  <% end %>
</div>

<% if @total_facts > 0 %>
  <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
    <table class="w-full border-collapse">
      <thead>
        <tr class="bg-slate-50 border-b border-slate-200">
          <th class="px-5 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider whitespace-nowrap">ID</th>
          <th class="px-5 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider w-full">Body</th>
          <th class="px-5 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider whitespace-nowrap">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <% @facts.each do |fact| %>
          <tr class="hover:bg-indigo-50/40 transition h-20">
            <td class="align-middle px-5 py-4 text-sm font-mono text-slate-400"><%= fact.id %></td>
            <td class="align-middle px-5 py-4 text-sm text-slate-800">
              <p class="line-clamp-2 leading-relaxed"><%= fact.body %></p>
            </td>
            <td class="align-middle px-5 py-4 whitespace-nowrap">
              <div class="flex items-center gap-2">
                <%= link_to "Edit", edit_admin_fact_path(fact, page: @current_page),
                            class: "inline-flex items-center rounded-lg px-3 py-1.5 text-xs font-semibold text-indigo-700 bg-indigo-50 hover:bg-indigo-100 transition" %>
                <%= link_to "Delete", admin_fact_path(fact, page: @current_page),
                            data: { turbo_method: :delete, turbo_confirm: "Delete this fact?" },
                            class: "inline-flex items-center rounded-lg px-3 py-1.5 text-xs font-semibold text-red-700 bg-red-50 hover:bg-red-100 transition" %>
              </div>
            </td>
          </tr>
        <% end %>
        <% [10 - @facts.length, 0].max.times do %>
          <tr aria-hidden="true" class="h-20">
            <td class="px-5 py-4 text-sm">&nbsp;</td>
            <td class="px-5 py-4 text-sm">&nbsp;</td>
            <td class="px-5 py-4 whitespace-nowrap">&nbsp;</td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <% if @total_pages > 1 %>
      <div class="flex items-center justify-between px-5 py-4 border-t border-slate-100">
        <div class="flex items-center gap-2">
          <% if @current_page > 1 %>
            <%= link_to "&#171; First".html_safe, admin_facts_path(page: 1),
                        class: "inline-flex items-center rounded-lg px-3 py-1.5 text-xs font-semibold text-slate-700 bg-slate-100 hover:bg-slate-200 transition" %>
            <%= link_to "&#8249; Previous".html_safe, admin_facts_path(page: @current_page - 1),
                        class: "inline-flex items-center rounded-lg px-3 py-1.5 text-xs font-semibold text-slate-700 bg-slate-100 hover:bg-slate-200 transition" %>
          <% else %>
            <span class="inline-flex items-center rounded-lg px-3 py-1.5 text-xs font-semibold text-slate-400 bg-slate-50 select-none">&#171; First</span>
            <span class="inline-flex items-center rounded-lg px-3 py-1.5 text-xs font-semibold text-slate-400 bg-slate-50 select-none">&#8249; Previous</span>
          <% end %>
        </div>

        <span class="text-sm text-slate-500">Page <%= @current_page %> of <%= @total_pages %></span>

        <div class="flex items-center gap-2">
          <% if @current_page < @total_pages %>
            <%= link_to "Next &#8250;".html_safe, admin_facts_path(page: @current_page + 1),
                        class: "inline-flex items-center rounded-lg px-3 py-1.5 text-xs font-semibold text-slate-700 bg-slate-100 hover:bg-slate-200 transition" %>
            <%= link_to "Last &#187;".html_safe, admin_facts_path(page: @total_pages),
                        class: "inline-flex items-center rounded-lg px-3 py-1.5 text-xs font-semibold text-slate-700 bg-slate-100 hover:bg-slate-200 transition" %>
          <% else %>
            <span class="inline-flex items-center rounded-lg px-3 py-1.5 text-xs font-semibold text-slate-400 bg-slate-50 select-none">Next &#8250;</span>
            <span class="inline-flex items-center rounded-lg px-3 py-1.5 text-xs font-semibold text-slate-400 bg-slate-50 select-none">Last &#187;</span>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="text-center py-20 bg-white rounded-2xl border border-slate-200">
    <p class="text-4xl mb-4">&#x1F4AD;</p>
    <p class="text-slate-600 font-medium mb-1">No fun facts yet</p>
    <p class="text-sm text-slate-400 mb-6">Start by adding your first fact.</p>
    <%= link_to "Add the first one", new_admin_fact_path,
                class: "inline-flex items-center gap-1.5 rounded-xl bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-700 transition" %>
  </div>
<% end %>
