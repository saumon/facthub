<div class="flex items-center justify-between mb-8">
  <div>
    <h1 class="text-2xl font-bold text-white">Eligible Clients</h1>
    <p class="text-sm text-indigo-300 mt-0.5"><%= pluralize(@clients.size, "client") %> registered</p>
  </div>
  <%= link_to new_admin_client_path,
              class: "inline-flex items-center gap-1.5 rounded-xl bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-700 active:bg-indigo-800 transition shadow-sm" do %>
    <span class="text-base leading-none">&#43;</span> New Client
  <% end %>
</div>

<% if @clients.any? %>
  <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
    <div class="overflow-x-auto">
    <table class="w-full border-collapse min-w-max">
      <thead>
        <tr class="bg-slate-50 border-b border-slate-200">
          <th class="px-5 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider w-px whitespace-nowrap">Client ID</th>
          <th class="px-5 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Alias</th>
          <th class="px-5 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Progression</th>
          <th class="px-5 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider whitespace-nowrap">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <% @clients.each do |client| %>
          <tr class="hover:bg-indigo-50/40 transition">
            <td class="px-5 py-4 font-mono text-xs text-slate-700 whitespace-nowrap"><%= client.client_identifier %></td>
            <td class="px-5 py-4 text-sm">
              <% if client.alias.present? %>
                <span class="text-slate-800"><%= client.alias %></span>
              <% else %>
                <span class="text-slate-400 italic">No alias defined</span>
              <% end %>
            </td>
            <td class="px-5 py-4 text-sm text-slate-600">
              <% if client.last_fact_id.present? %>
                Last fact id: <span class="font-semibold text-slate-800"><%= client.last_fact_id %> / <%= @facts_count %></span>
              <% else %>
                <span class="text-slate-400 italic">No progress yet</span>
              <% end %>
            </td>
            <td class="px-5 py-4 whitespace-nowrap">
              <div class="flex items-center gap-2">
                <%= link_to "View", admin_client_path(client),
                            class: "inline-flex items-center rounded-lg px-3 py-1.5 text-xs font-semibold text-indigo-700 bg-indigo-50 hover:bg-indigo-100 transition" %>
                <%= link_to "Reset", reset_admin_client_path(client),
                            data: { turbo_method: :post, turbo_confirm: "Reset this client's progression?" },
                            class: "inline-flex items-center rounded-lg px-3 py-1.5 text-xs font-semibold text-amber-700 bg-amber-50 hover:bg-amber-100 transition" %>
                <%= link_to "Delete", admin_client_path(client),
                            data: { turbo_method: :delete, turbo_confirm: "Delete this client? This cannot be undone." },
                            class: "inline-flex items-center rounded-lg px-3 py-1.5 text-xs font-semibold text-red-700 bg-red-50 hover:bg-red-100 transition" %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
    </div>
  </div>
<% else %>
  <div class="text-center py-20 bg-white rounded-2xl border border-slate-200">
    <p class="text-4xl mb-4">&#x1F4CB;</p>
    <p class="text-slate-600 font-medium mb-1">No eligible clients yet</p>
    <p class="text-sm text-slate-400 mb-6">Create your first client to start serving sequential facts.</p>
    <%= link_to "Create the first client", new_admin_client_path,
                class: "inline-flex items-center gap-1.5 rounded-xl bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-700 transition" %>
  </div>
<% end %>
