<div>
  <div class="flex items-center justify-between mb-8">
    <div>
      <h1 class="text-2xl font-bold text-white">Client Detail</h1>
      <p class="text-sm text-indigo-300 mt-0.5">Created <%= @client.created_at.strftime("%B %d, %Y") %></p>
    </div>
    <%= link_to "← All Clients", admin_clients_path,
                class: "text-sm text-slate-400 hover:text-white transition" %>
  </div>

  <div class="bg-white rounded-2xl shadow-sm border border-slate-200 divide-y divide-slate-100">
    <div class="px-6 py-5">
      <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1.5">Client Identifier</p>
      <div class="flex items-center gap-3">
        <code id="client-identifier" class="flex-1 font-mono text-sm text-slate-800 bg-slate-50 rounded-lg px-4 py-2.5 border border-slate-200 break-all select-all">
          <%= @client.client_identifier %>
        </code>
        <button
          onclick="navigator.clipboard.writeText('<%= @client.client_identifier %>').then(() => this.textContent = 'Copied!').catch(() => {}); setTimeout(() => this.textContent = 'Copy', 1500)"
          class="shrink-0 inline-flex items-center rounded-lg px-3 py-2 text-xs font-semibold text-indigo-700 bg-indigo-50 hover:bg-indigo-100 transition"
          type="button"
        >Copy</button>
      </div>
    </div>

    <div class="px-6 py-5">
      <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1.5">Alias</p>
      <% if @client.alias.present? %>
        <p class="text-sm text-slate-800 mb-3"><%= @client.alias %></p>
      <% else %>
        <p class="text-sm text-slate-400 italic mb-3">No alias defined</p>
      <% end %>

      <%= form_with model: @client, url: admin_client_path(@client), method: :patch do |f| %>
        <div class="flex items-start gap-2">
          <%= f.text_field :alias,
                value: @client.alias,
                placeholder: "Enter alias (optional)",
                class: "flex-1 rounded-lg border border-slate-300 px-3 py-2 text-sm text-slate-800 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 outline-none" %>
          <%= f.submit "Save",
                class: "shrink-0 inline-flex items-center rounded-lg px-4 py-2 text-sm font-semibold text-indigo-700 bg-indigo-50 hover:bg-indigo-100 border border-indigo-200 transition" %>
        </div>
        <% if @client.errors[:alias].any? %>
          <p class="mt-1 text-xs text-red-600"><%= @client.errors[:alias].first %></p>
        <% end %>
        <p class="mt-1 text-xs text-slate-400">Max 100 characters. Leave blank to clear the alias.</p>
      <% end %>
    </div>

    <div class="px-6 py-5">
      <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-3">Current Progression</p>
      <% if @client.last_fact_id.present? %>
        <div class="mb-4">
          <p class="text-xs text-slate-400 uppercase tracking-wide mb-1">Last fact served — #<%= @client.last_fact_id %> / <%= @facts_count %></p>
          <% if @last_fact %>
            <p class="text-sm text-slate-800 bg-slate-50 rounded-lg px-4 py-2.5 border border-slate-200 leading-relaxed"><%= @last_fact.body %></p>
          <% else %>
            <p class="text-sm text-slate-400 italic">Fact #<%= @client.last_fact_id %> has been deleted.</p>
          <% end %>
        </div>
      <% else %>
        <p class="text-sm text-slate-400 italic mb-4">No facts served yet — progression starts at the first call.</p>
      <% end %>
      <div>
        <p class="text-xs text-slate-400 uppercase tracking-wide mb-1">Next fact</p>
        <% if @next_fact %>
          <p class="text-sm text-slate-800 bg-indigo-50 rounded-lg px-4 py-2.5 border border-indigo-100 leading-relaxed">
            <span class="text-xs font-semibold text-indigo-400 mr-2">#<%= @next_fact.id %></span><%= @next_fact.body %>
          </p>
        <% else %>
          <p class="text-sm text-slate-400 italic">No facts available in the catalog.</p>
        <% end %>
      </div>
    </div>

    <div class="px-6 py-5 flex items-center gap-3">
      <%= button_to "Reset Progression", reset_admin_client_path(@client),
                    method: :post,
                    data: { turbo_confirm: "Reset progression for this client? Their next call will restart from the first fact." },
                    class: "inline-flex items-center rounded-xl px-4 py-2 text-sm font-semibold text-amber-700 bg-amber-50 hover:bg-amber-100 border border-amber-200 transition" %>
      <%= button_to "Delete Client", admin_client_path(@client),
                    method: :delete,
                    data: { turbo_confirm: "Permanently delete this client? This cannot be undone." },
                    class: "inline-flex items-center rounded-xl px-4 py-2 text-sm font-semibold text-red-700 bg-red-50 hover:bg-red-100 border border-red-200 transition" %>
    </div>
  </div>
</div>
