<!DOCTYPE html>
<html lang="en">
  <head>
    <title>Fact Hub — Admin</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="min-h-screen bg-gradient-to-br from-indigo-950 via-indigo-900 to-slate-900 flex flex-col items-center pt-20 px-4">
    <%= yield %>
    <footer class="mt-8 text-center">
      <a href="https://github.com/saumon/facthub?tab=readme-ov-file#-changelog"
         target="_blank" rel="noopener noreferrer"
         class="text-xs text-indigo-400/60 hover:text-indigo-300 transition">v1.2.1</a>
    </footer>
  </body>
</html>
